      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "odp"
          },
          "editorMode": "code",
          "expr": "100 * (1 - max by (instance) (node_filesystem_avail_bytes{instance=~\"$host\",mountpoint=\"/\"} / node_filesystem_size_bytes{instance=~\"$host\",mountpoint=\"/\"}))",
          "legendFormat": "{{instance}} /",
          "refId": "A"
        }
      ],
      "title": "Storage Used",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "odp"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "odp"
          },
          "editorMode": "code",
          "expr": "sum by (instance) (rate(node_network_receive_bytes_total{instance=~\"$host\",device=~\"^(endp1|end0|enp.*|eno.*|ens.*|enx.*|eth.*)$\"}[5m]) + rate(node_network_transmit_bytes_total{instance=~\"$host\",device=~\"^(endp1|end0|enp.*|eno.*|ens.*|enx.*|eth.*)$\"}[5m]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "Network Throughput",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "odp-logs"
      },
      "description": "Use the Systemd Unit dropdown in the dashboard toolbar to filter these logs.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "id": 6,
      "options": {
        "dedupStrategy": "none",
        "enableInfiniteScrolling": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Ascending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "odp-logs"
          },
          "editorMode": "code",
          "expr": "{host=~\"$host\", unit=~\"$unit\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Systemd Unit Logs",
      "type": "logs"
    }
